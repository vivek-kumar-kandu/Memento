# Dhwani-Sanjeevani Backend Configuration Example

PROJECT_NAME="Dhwani-Sanjeevani Backend"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database: SQLite async via aiosqlite for local development
DATABASE_URL="sqlite+aiosqlite:///./dhwani_sanjeevani.db"

# Data Paths (relative to repository root or absolute)
DATA_DIR="../Data"
FACILITY_CLEAN_CSV="../Data/phc_chc_facilities_clean.csv"
FACILITY_NEARBY_JSON="../Data/phc_chc_facilities_for_nearby_search.json"

# Geo Search Parameters
DEFAULT_SEARCH_RADIUS_KM=30.0
MAX_SEARCH_RADIUS_KM=150.0
DEFAULT_FACILITY_LIMIT=10
MAX_FACILITY_LIMIT=50

# Telephony / Webhook Secrets (for future milestone)
EDESY_WEBHOOK_SECRET="replace-with-edesy-webhook-secret"
