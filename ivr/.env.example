# Server Configuration
HOST=127.0.0.1
PORT=8001

# Sanjeevani Backend API Base URL (provided by FastAPI backend teammate)
BACKEND_BASE_URL=https://sanjeevini-ai.onrender.com
BACKEND_TIMEOUT_SECONDS=15.0

# Call session settings
DEFAULT_LANGUAGE=hindi
MAX_NO_INPUT_RETRIES=2
MAX_BACKEND_RETRIES=1

# Edesy IVR Provider Configuration (placeholders)
EDESY_API_KEY=your_edesy_api_key_here
EDESY_API_SECRET=your_edesy_api_secret_here
EDESY_WEBHOOK_SECRET=your_edesy_webhook_secret_here

