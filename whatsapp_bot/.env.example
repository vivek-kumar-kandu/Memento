# Dhwani-Sanjeevani WhatsApp Bot Adapter Configuration

# Server Settings
HOST=127.0.0.1
PORT=8002

# Dhwani-Sanjeevani FastAPI Backend URL
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_SECONDS=10.0
MAX_BACKEND_RETRIES=1

# Meta WhatsApp Cloud API Credentials
# Configure in Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temporary_meta_user_access_token_here
WHATSAPP_VERIFY_TOKEN=sanjeevini_webhook_secret_verify_token
GRAPH_API_VERSION=v21.0

# Optional Meta App Secret for X-Hub-Signature-256 payload verification
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Session Persistence File Path (stores conversation_id and case_id mappings across restarts)
SESSION_STORAGE_PATH=./whatsapp_sessions.json
